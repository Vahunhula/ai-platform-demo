# Paths are resolved relative to the repository unless set to absolute paths.
AI_PLATFORM_DATA_DIR=data
AI_PLATFORM_WORKSPACE_ROOT=workspaces
AI_PLATFORM_DB_PATH=data/platform.db
AI_PLATFORM_CHECKPOINT_DB_PATH=data/langgraph-checkpoints.db

# Reserved for the future Claude executor. Do not commit a populated .env file.
ANTHROPIC_API_KEY=
AI_PLATFORM_CHEAP_MODEL=claude-cheap-not-configured
AI_PLATFORM_DEFAULT_MODEL=claude-default-not-configured
AI_PLATFORM_STRONG_MODEL=claude-strong-not-configured

# Restrict checkpoint deserialization to supported safe types.
LANGGRAPH_STRICT_MSGPACK=true
